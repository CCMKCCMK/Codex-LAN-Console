<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF popups and context menus resolve specific cultures such as en-US. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.9.0</Version>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))=/_/CodexLanConsole</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="tmp\**;artifacts\**" />
    <None Remove="tmp\**;artifacts\**" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CodexLanBridge.ProtocolTests</_Parameter1>
    </AssemblyAttribute>
    <Content
      Include="..\..\frontend\web\**\*"
      Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
